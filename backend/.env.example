# --- TravelMate backend configuration ---
# Set to true to run entirely in-memory (mongomock) with no MongoDB required.
# Set to false to use a real MongoDB via MONGODB_URI.
USE_MOCK_DB=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=travelmate

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma separated). Vite dev server default is 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the database with realistic demo data on startup (dev convenience).
SEED_ON_STARTUP=true
